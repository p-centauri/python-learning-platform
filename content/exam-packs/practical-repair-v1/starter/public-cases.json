  {
    "name": "Atomic rollback",
    "public": true,
    "args": [
      {
        "kind": "orders",
        "principal": "alpha",
        "stock": 2,
        "commands": [
          {
            "tenant": "alpha",
            "key": "one",
            "qty": 1,
            "fail": true
          },
          {
            "tenant": "alpha",
            "key": "one",
            "qty": 1
          }
        ]
      }
    ],
    "expected": {
      "results": [
        "rolled-back",
        "created"
      ],
      "stock": 1,
      "orders": 1,
      "outbox": 1
    }
  },
  {
    "name": "Commit then lost acknowledgment",
    "public": true,
    "args": [
      {
        "kind": "events",
        "principal": "alpha",
        "events": [
