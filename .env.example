# Docker Compose local development only. Change credentials before deployment.
POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy-local-change-before-deploy
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_COOKIES=false
SESSION_DAYS=14
# For host-based PostgreSQL development, set in apps/api/.env:
# DATABASE_URL=postgresql+psycopg2://academy:password@localhost:5432/academy

# Host runner setup is separate: make runner-setup creates .local/runner.env.
# Do not publish the token or mount a Docker socket into the API.
# Compose separates maintenance credentials from the application database role.
ACADEMY_APP_USER=academy_app
ACADEMY_APP_PASSWORD=academy-app-local-change-before-deploy
